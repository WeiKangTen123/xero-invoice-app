# ═══════════════════════════════════════════════════════════════
#  COPY THIS FILE TO .env AND FILL IN YOUR VALUES
#  DO NOT COMMIT .env TO GITHUB — it is in .gitignore already
#
#  Everything below is read by the server (grep process.env in main/).
#  Per-user settings — Xero app credentials, the mailbox, the Gemini key,
#  invoice defaults — are entered on the Setup page and stored encrypted in
#  the database, not here.
# ═══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Bind address. In production the app sits behind nginx and binds to
# 127.0.0.1 by default; set 0.0.0.0 only if it must be reachable directly.
# HOST=127.0.0.1

# Signs login tokens — REQUIRED. Without this set, the app falls back to an
# insecure hardcoded dev value, which lets anyone forge a valid login token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Encrypts stored Xero/IMAP/Gemini credentials at rest — REQUIRED.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Losing this key makes all
# previously-saved credentials unreadable — keep a copy in a password
# manager. docs/RUNBOOK.md says what to back up.
ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

# ── Accounts ────────────────────────────────────────────────
# The first account to register becomes admin; after that registration is
# CLOSED and admins add users on the Admin page. Set to true only if you want
# anyone who can reach the URL to be able to create an account.
# ALLOW_REGISTRATION=true

# ── Xero OAuth2 "Web app" connection ─────────────────────────
# Each user brings their own Xero Web app's Client ID/Secret via the Setup
# page. Only the redirect URI is deployment-wide, since it's a property of
# this server, not of any one user's Xero app. Must be HTTPS in production
# and match a redirect URI registered on every user's Web app exactly.
# http://localhost is allowed for local development only.
XERO_OAUTH_REDIRECT_URI=
# Where the browser is sent after Xero's consent screen when the UI is served
# by the Vite dev server rather than by this app (development only).
# FRONTEND_URL=http://localhost:5173

# ── LLM (Gemini) — global fallback, normally set per-user in Setup ───────────
# Get one at aistudio.google.com
Gemini_API_KEY=

# ── Notifications (optional) ─────────────────────────────────
# Slack webhook for invoice created / error alerts and for a fatal process
# exit. Leave blank to disable.
SLACK_WEBHOOK_URL=

# ── Xero invoice defaults (global fallback, normally set per-user in Setup) ──
DEFAULT_ACCOUNT_CODE=310
DEFAULT_CURRENCY=SGD
# Tax type name used for zero-tax lines when the org's rates don't match.
# ZERO_TAX_RATE=NONE

# ── Storage and logs (defaults are fine; override to move them) ──────────
# SQLite file. Backups go to <DATA_DIR>/backups.
# DB_PATH=main/data/app.db
# Receipts, PDFs, mail and job queues live under <DATA_DIR>/users/<id>.
# DATA_DIR=main/data
# LOGS_DIR=logs
# LOG_LEVEL=info
