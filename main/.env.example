# ═══════════════════════════════════════════════════════════════
#  COPY THIS FILE TO .env AND FILL IN YOUR VALUES
#  DO NOT COMMIT .env TO GITHUB — it is in .gitignore already
#  On Railway: paste each value into Variables tab instead
# ═══════════════════════════════════════════════════════════════

# ── Xero OAuth2 ──────────────────────────────────────────────
# Get these from developer.xero.com → your app → Configuration tab
XERO_CLIENT_ID=paste_your_client_id_here
XERO_CLIENT_SECRET=paste_your_client_secret_here
# Local dev:  http://localhost:3000/xero/callback
# Railway:    https://yourapp.up.railway.app/xero/callback
XERO_REDIRECT_URI=https://yourapp.up.railway.app/xero/callback

# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Any long random string — used to sign session cookies
SESSION_SECRET=change_this_to_a_long_random_string_min_32_chars
# Your Railway app public URL (no trailing slash)
APP_URL=https://yourapp.up.railway.app

# ── PostgreSQL ────────────────────────────────────────────────
# Railway sets this automatically when you add a Postgres service
# For local dev: postgresql://postgres:password@localhost:5432/xero_invoices
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SSL=true

# ── Redis ─────────────────────────────────────────────────────
# Railway sets this automatically when you add a Redis service
# For local dev: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Email inbox (IMAP) ────────────────────────────────────────
# Gmail:   IMAP_HOST=imap.gmail.com  IMAP_PORT=993
# Outlook: IMAP_HOST=outlook.office365.com  IMAP_PORT=993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_invoice_inbox@gmail.com
# For Gmail: use an App Password (not your Gmail login password)
# Generate at: myaccount.google.com → Security → App passwords
IMAP_PASS=your_16_char_gmail_app_password
# How often to poll for new emails (ms). 60000 = every 1 minute
IMAP_POLL_INTERVAL_MS=60000

# ── Notifications (optional) ─────────────────────────────────
# Slack webhook for invoice created / error alerts
# Leave blank to disable Slack notifications
SLACK_WEBHOOK_URL=

# ── Xero invoice defaults ────────────────────────────────────
# Account code for expense line items (check your Xero chart of accounts)
DEFAULT_ACCOUNT_CODE=310
# Your Xero org currency code
DEFAULT_CURRENCY=SGD
