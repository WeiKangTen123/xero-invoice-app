# ═══════════════════════════════════════════════════════════════
#  COPY THIS FILE TO .env AND FILL IN YOUR VALUES
#  DO NOT COMMIT .env TO GITHUB — it is in .gitignore already
# ═══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Signs login tokens — REQUIRED. Without this set, the app falls back to an
# insecure hardcoded dev value, which lets anyone forge a valid login token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Encrypts stored Xero/IMAP/Gemini credentials at rest — REQUIRED.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Losing this key makes all
# previously-saved credentials unreadable — back it up somewhere safe.
ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

# ── Xero OAuth2 (global fallback — normally set per-user in the Setup page) ───
# Get these from developer.xero.com → your app → Configuration tab
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# ── Xero OAuth2 "Web app" connection (Authorization Code — 2nd, optional method,
#    separate from the Custom Connection fields above) ───────────────────────
# One shared app for the whole deployment; each user authorizes their own Xero
# organisation via the consent screen (Setup page → "Connect to Xero").
# developer.xero.com → your Web app → Configuration tab.
XERO_OAUTH_CLIENT_ID=
XERO_OAUTH_CLIENT_SECRET=
# Must be HTTPS in production and match a redirect URI registered on the app
# exactly. http://localhost is allowed for local development only.
XERO_OAUTH_REDIRECT_URI=

# ── Redis (optional — job queue falls back to inline processing without it) ──
REDIS_URL=redis://localhost:6379

# ── Email inbox (IMAP) — global fallback, normally set per-user in Setup ─────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# For Gmail: use an App Password (not your Gmail login password)
# Generate at: myaccount.google.com → Security → App passwords
IMAP_PASS=
IMAP_POLL_INTERVAL_MS=60000

# ── LLM (Gemini) — global fallback, normally set per-user in Setup ───────────
# Get one at aistudio.google.com
Gemini_API_KEY=

# ── Notifications (optional) ─────────────────────────────────
# Slack webhook for invoice created / error alerts. Leave blank to disable.
SLACK_WEBHOOK_URL=

# ── Xero invoice defaults ────────────────────────────────────
DEFAULT_ACCOUNT_CODE=310
DEFAULT_CURRENCY=SGD
