{
  "name": "xero-invoice-app",
  "version": "1.0.0",
  "description": "Production-ready email-to-Xero invoice automation",
  "main": "main/index.js",
  "scripts": {
    "start": "node main/index.js",
    "dev:server": "nodemon --delay 500ms --ext js --ignore 'main/data' --ignore 'logs' --ignore 'ui' main/index.js",
    "dev:ui": "npm --prefix ui run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "build:ui": "npm --prefix ui run build",
    "test": "jest --runInBand --forceExit",
    "backup": "node main/db/backup.js",
    "smoke": "node main/scripts/smoke-xero.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.1",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "imap": "^0.8.17",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.6.5",
    "morgan": "^1.10.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.3.1",
    "qrcode": "^1.5.4",
    "winston": "^3.11.0",
    "xero-node": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "testTimeout": 20000
  }
}
